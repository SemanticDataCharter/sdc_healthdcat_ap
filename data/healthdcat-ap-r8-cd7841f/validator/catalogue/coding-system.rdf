  <rdf:Description rdf:about="https://hdeu-dcat.data.health.europa.eu/resource/authority/coding-system/ATC">
    <skos:inScheme rdf:resource="https://hdeu-dcat.data.health.europa.eu/resource/authority/coding-system"/>
    <dct:description xml:lang="en">WHO classification system for medicines according to the organ or system they act on and their therapeutic, pharmacological, and chemical properties</dct:description>
    <skos:prefLabel xml:lang="es">Sistema de Clasificación Anatómica, Terapéutica y Química</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Anatomisk terapeutisk kemisk klassifikationssystem</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Anatomicko-terapeuticko-chemický klasifikačný systém</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Anatomical Therapeutic Chemical Classification System</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Anatómiai, terápiás és kémiai osztályozási rendszer</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Anatomsko terapijsko kemijski klasifikacijski sustav</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Système de classification anatomique, thérapeutique et chimique</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Anatominė terapinė cheminė klasifikavimo sistema</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Анатомо-терапевтично-химична класификационна система</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Anatomicko-terapeuticko-chemický klasifikační systém</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Anatomsko-terapevtsko-kemijski klasifikacijski sistem</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Anatoomilis-terapeutilis-keemiline klassifikatsioonisüsteem</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Ανατομικό, Θεραπευτικό και Χημικό Σύστημα Ταξινόμησης</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Anatomisch-therapeutisch-chemisches Klassifikationssystem</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Anatomis-terapeuttis-kemiallinen luokitusjärjestelmä</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Sistemul de clasificare anatomică, terapeutică și chimică</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Anatomiski terapeitiski ķīmiskā klasifikācijas sistēma</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Sistema de Classificação Anatómica, Terapêutica e Química</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Sistema ta' Klassifikazzjoni Anatomika, Terapewtika u Kimika</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Córas Aicmithe Anatamaíche, Teiripeacha agus Ceimicí</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">System Klasyfikacji Anatomiczno-Terapeutyczno-Chemicznej</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Sistema di classificazione anatomica, terapeutica e chimica</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Anatomiskt, terapeutiskt och kemiskt klassifikationssystem</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Anatomisch therapeutisch chemisch classificatiesysteem</skos:prefLabel>
    <rdf:type rdf:resource="http://purl.org/dc/terms/Standard"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:title xml:lang="en">Anatomical Therapeutic Chemical Classification System</dct:title>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.data.health.europa.eu/resource/authority/coding-system"/>
    <skos:definition xml:lang="en">WHO classification system for medicines according to the organ or system they act on and their therapeutic, pharmacological, and chemical properties</skos:definition>
    <dct:identifier>ATC</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.data.health.europa.eu/resource/authority/coding-system/ICF">
    <skos:inScheme rdf:resource="https://hdeu-dcat.data.health.europa.eu/resource/authority/coding-system"/>
    <dct:description xml:lang="en">WHO classification and terminology for describing health, functioning, disability, and health-related domains. It covers body functions and structures, activities and participation, and environmental factors, and is used as the international standard to describe and measure health and disability at individual and population levels.</dct:description>
    <skos:prefLabel xml:lang="es">Clasificación Internacional del Funcionamiento, de la Discapacidad y de la Salud</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Clasificarea internațională a funcționării, dizabilității și sănătății</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Tarptautinė funkcionavimo, neįgalumo ir sveikatos klasifikacija</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Klassifikazzjoni Internazzjonali tal-Funzjonament, tad-Diżabilità u tas-Saħħa</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Classificazione internazionale del funzionamento, della disabilità e della salute</skos:prefLabel>
    <skos:prefLabel xml:lang="en">International Classification of Functioning, Disability and Health</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Διεθνής Ταξινόμηση της Λειτουργικότητας, της Αναπηρίας και της Υγείας</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Aicmiú Idirnáisiúnta ar Fheidhmiú, ar Mhíchumas agus ar Shláinte</skos:prefLabel>
    <skos:prefLabel xml:lang="da">International klassifikation af funktionsevne, handicap og sundhed</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Internationell klassifikation av funktionstillstånd, funktionshinder och hälsa</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Internationale Klassifikation der Funktionsfähigkeit, Behinderung und Gesundheit</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">A működőképesség, fogyatékosság és egészség nemzetközi osztályozása</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Medzinárodná klasifikácia funkčnosti, disability a zdravia</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Internationale classificatie van functioneren, beperkingen en gezondheid</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Classification internationale du fonctionnement, du handicap et de la santé</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Starptautiskā funkcionēšanas, nespējas un veselības klasifikācija</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Rahvusvaheline funktsioneerimisvõime, vaeguste ja tervise klassifikatsioon</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Международна класификация на функционирането, уврежданията и здравето</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Międzynarodowa Klasyfikacja Funkcjonowania, Niepełnosprawności i Zdrowia</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Classificação Internacional de Funcionalidade, Incapacidade e Saúde</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Mezinárodní klasifikace funkčních schopností, disability a zdraví</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Toimintakyvyn, toimintarajoitteiden ja terveyden kansainvälinen luokitus</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Međunarodna klasifikacija funkcioniranja, invaliditeta i zdravlja</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Mednarodna klasifikacija funkcioniranja, invalidnosti in zdravja</skos:prefLabel>
    <rdf:type rdf:resource="http://purl.org/dc/terms/Standard"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <dct:title xml:lang="en">International Classification of Functioning, Disability and Health</dct:title>
    <skos:topConceptOf rdf:resource="https://hdeu-dcat.data.health.europa.eu/resource/authority/coding-system"/>
    <skos:definition xml:lang="en">WHO classification and terminology for describing health, functioning, disability, and health-related domains. It covers body functions and structures, activities and participation, and environmental factors, and is used as the international standard to describe and measure health and disability at individual and population levels.</skos:definition>
    <dct:identifier>ICF</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.data.health.europa.eu/resource/authority/coding-system/EMA-SPOR">
