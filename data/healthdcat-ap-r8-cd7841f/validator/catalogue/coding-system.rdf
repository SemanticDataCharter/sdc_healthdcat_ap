    <skos:prefLabel xml:lang="lv">Eiropas Zāļu aģentūras vielas, produkti, organizācijas un atsauces</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Europeiska läkemedelsmyndighetens substanser, produkter, organisationer och referenser</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Tvari, proizvodi, organizacije i referentni podaci Europske agencije za lijekove</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Snovi, izdelki, organizacije in referenčni podatki Evropske agencije za zdravila</skos:prefLabel>
