  <rdf:Description rdf:about="https://hdeu-dcat.data.health.europa.eu/resource/authority/publisher-type/other-company">
    <skos:inScheme rdf:resource="https://hdeu-dcat.data.health.europa.eu/resource/authority/publisher-type"/>
    <skos:prefLabel xml:lang="lt">Kitos rūšies įmonė, kuri tam tikru būdu renka sveikatos duomenis</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Altro tipo di azienda che in qualche modo raccoglie dati sanitari</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Outro tipo de empresa que de alguma forma recolhe dados de saúde</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Otro tipo de empresa que de alguna manera recopila datos de salud</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Andere Art von Unternehmen, das Gesundheitsdaten sammelt</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Jiný typ společnosti, která nějakým způsobem shromažďuje zdravotní údaje</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Other type of company that somehow collects health data</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Autre type d'entreprise qui collecte d'une manière ou d'une autre des données de santé</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Άλλος τύπος εταιρείας που συλλέγει με κάποιο τρόπο δεδομένα υγείας</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Cineál eile cuideachta a bhailíonn sonraí sláinte ar bhealach éigin</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Tip ieħor ta' kumpanija li b'xi mod tiġbor data dwar is-saħħa</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Inny rodzaj firmy, która w jakiś sposób gromadzi dane dotyczące zdrowia</skos:prefLabel>
    <skos:prefLabel xml:lang="nn">Anna type selskap som på ein eller annan måte samlar inn helsedata</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Muud tüüpi ettevõte, mis kogub mingil moel terviseandmeid</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Muu yritys, joka kerää terveystietoja</skos:prefLabel>
    <skos:prefLabel xml:lang="is">Annars konar fyrirtæki sem safnar heilsufarsupplýsingum á einhvern hátt</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Druga vrsta podjetja, ki nekako zbira zdravstvene podatke</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Druga vrsta tvrtke koja na neki način prikuplja zdravstvene podatke</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Ander type bedrijf dat op de een of andere manier gezondheidsgegevens verzamelt</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Más típusú vállalat, amely valamilyen módon egészségügyi adatokat gyűjt</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Cita veida uzņēmums, kas kaut kādā veidā vāc veselības datus</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Annan typ av företag som på något sätt samlar in hälsodata</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Друг вид компания, която по някакъв начин събира здравни данни</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Iný typ spoločnosti, ktorá nejakým spôsobom zhromažďuje údaje o zdraví</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Anden type virksomhed, der på en eller anden måde indsamler sundhedsdata</skos:prefLabel>
    <skos:prefLabel xml:lang="nb">Annen type selskap som på en eller annen måte samler inn helsedata</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Alt tip de companie care colectează cumva date de sănătate</skos:prefLabel>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://hdeu-dcat.data.health.europa.eu/resource/authority/publisher-type/private-sector-entities"/>
    <dct:title xml:lang="en">Other type of company that somehow collects health data</dct:title>
    <skos:definition xml:lang="en">Other type of company that somehow collects health data</skos:definition>
    <dct:identifier rdf:resource="https://hdeu-dcat.data.health.europa.eu/resource/authority/publisher-type/other-company"/>
  </rdf:Description>
