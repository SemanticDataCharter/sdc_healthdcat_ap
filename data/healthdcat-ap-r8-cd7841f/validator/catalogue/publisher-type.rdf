  <rdf:Description rdf:about="https://hdeu-dcat.data.health.europa.eu/resource/authority/publisher-type/other-public-institute">
    <skos:inScheme rdf:resource="https://hdeu-dcat.data.health.europa.eu/resource/authority/publisher-type"/>
    <skos:prefLabel xml:lang="cs">Jiné veřejné ústavy, které shromažďují zdravotní údaje</skos:prefLabel>
    <skos:prefLabel xml:lang="nn">Andre offentlege institutt som samlar inn helsedata</skos:prefLabel>
    <skos:prefLabel xml:lang="is">Aðrar opinberar stofnanir sem safna heilsufarsupplýsingum</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Citas publiskās iestādes, kas vāc veselības datus</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Andere öffentliche Institute, die Gesundheitsdaten sammeln</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Alte institute publice care colectează date de sănătate</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Muud avalik-õiguslikud asutused, mis koguvad terviseandmeid</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Druge javne ustanove koje prikupljaju zdravstvene podatke</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Kitos viešosios įstaigos, renkančios sveikatos duomenis</skos:prefLabel>
    <skos:prefLabel xml:lang="nb">Andre offentlige institutter som samler inn helsedata</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Más közintézmények, amelyek egészségügyi adatokat gyűjtenek</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Istituti pubbliċi oħra li jiġbru data dwar is-saħħa</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Άλλα δημόσια ιδρύματα που συλλέγουν δεδομένα υγείας</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Outros institutos públicos que recolhem dados de saúde</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Druge javne ustanove, ki zbirajo zdravstvene podatke</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Andere openbare instituten die gezondheidsgegevens verzamelen</skos:prefLabel>
