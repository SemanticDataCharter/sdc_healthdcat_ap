    <skos:prefLabel xml:lang="ro">IHE Partajarea documentelor între întreprinderi - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="es">IHE Intercambio de documentos entre empresas - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">IHE Documentendeling tussen ondernemingen - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">IHE Vállalatközi dokumentummegosztás - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">IHE Междуфирмено споделяне на документи - IHE-XDS.b</skos:prefLabel>
