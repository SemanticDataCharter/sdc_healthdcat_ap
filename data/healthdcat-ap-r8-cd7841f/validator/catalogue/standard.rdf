  <rdf:Description rdf:about="https://hdeu-dcat.data.health.europa.eu/resource/authority/standard/IHE-XDS.b">
    <skos:inScheme rdf:resource="https://hdeu-dcat.data.health.europa.eu/resource/authority/standard"/>
    <dct:description xml:lang="en">IHE integration profile for registering, distributing, discovering, and accessing patient electronic health-record documents across healthcare enterprises. It provides a standards-based way to manage document sharing between organizations such as physician offices, clinics, and hospitals.</dct:description>
    <skos:prefLabel xml:lang="lv">IHE Uzņēmumu savstarpēja dokumentu apmaiņa - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="et">IHE Ettevõtetevaheline dokumentide jagamine - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="it">IHE Condivisione di documenti tra imprese - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">IHE Įmonių dokumentų dalijimasis - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="el">IHE Διεπιχειρησιακή κοινή χρήση εγγράφων - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">IHE Dokumentdelning mellan företag - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="de">IHE Unternehmensübergreifende Dokumentenfreigabe - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">IHE Međupoduzetnička razmjena dokumenata - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">IHE Sdílení dokumentů mezi podniky - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">IHE Partage de documents inter-entreprises - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">IHE Zdieľanie dokumentov medzi podnikmi - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">IHE Partilha de documentos entre empresas - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">IHE Kondiviżjoni ta' Dokumenti bejn l-Intrapriżi - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="da">IHE Deling af dokumenter på tværs af virksomheder - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">IHE Izmenjava dokumentov med podjetji - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="en">IHE Cross-Enterprise Document Sharing - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">IHE Międzyorganizacyjne udostępnianie dokumentów - IHE-XDS.b</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">IHE Comhroinnt Doiciméad Trasfhiontair - IHE-XDS.b</skos:prefLabel>
