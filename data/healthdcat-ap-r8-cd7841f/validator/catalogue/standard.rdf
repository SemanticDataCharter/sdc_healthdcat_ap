    <dct:title xml:lang="en">Health Level Seven Standards</dct:title>
    <skos:definition xml:lang="en">Family of standards developed by Health Level Seven International for the electronic exchange, integration, sharing, and retrieval of health information across healthcare systems. HL7 includes several standards and product families, such as HL7 Version 2, HL7 Version 3, CDA, and FHIR.</skos:definition>
    <dct:identifier>HL7</dct:identifier>
  </rdf:Description>
  <rdf:Description rdf:about="https://hdeu-dcat.data.health.europa.eu/resource/authority/standard/DICOM">
    <skos:inScheme rdf:resource="https://hdeu-dcat.data.health.europa.eu/resource/authority/standard"/>
    <dct:description xml:lang="en">International standard for the communication and management of medical imaging information and related data. It supports interoperability for transmitting, storing, retrieving, processing, and displaying medical images and associated information across imaging devices and healthcare systems.</dct:description>
