    <skos:prefLabel xml:lang="pt">Arquitetura de documentos clínicos</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Architektura dokumentów klinicznych</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Clinical Document Architecture</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Klinikai dokumentumok architektúrája</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Architectuur voor klinische documenten</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Архитектура на клиничните документи</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Kliinisten asiakirjojen arkkitehtuuri</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Arhitektura kliničkih dokumenata</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Arhitektura kliničnih dokumentov</skos:prefLabel>
    <skos:prefLabel xml:lang="es">Arquitectura de documentos clínicos</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Klīnisko dokumentu arhitektūra</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Arkitektur for kliniske dokumenter</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Architettura dei documenti clinici</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Arkitektur för kliniska dokument</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Ailtireacht Doiciméad Cliniciúil</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Architektura klinických dokumentů</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Αρχιτεκτονική κλινικών εγγράφων</skos:prefLabel>
