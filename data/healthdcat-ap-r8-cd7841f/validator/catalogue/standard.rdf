  <rdf:Description rdf:about="https://hdeu-dcat.data.health.europa.eu/resource/authority/standard/FHIR">
    <skos:inScheme rdf:resource="https://hdeu-dcat.data.health.europa.eu/resource/authority/standard"/>
    <dct:description xml:lang="en">HL7 standard for exchanging healthcare information electronically, based on modular resources and designed for implementation using modern web technologies. FHIR supports RESTful APIs and multiple exchange formats, including JSON, XML, and RDF.</dct:description>
    <skos:prefLabel xml:lang="es">Recursos rápidos de interoperabilidad sanitaria</skos:prefLabel>
    <skos:prefLabel xml:lang="hr">Brzi resursi za interoperabilnost u zdravstvu</skos:prefLabel>
    <skos:prefLabel xml:lang="mt">Riżorsi Rapidi ta' Interoperabbiltà tal-Kura tas-Saħħa</skos:prefLabel>
    <skos:prefLabel xml:lang="el">Ταχείς πόροι διαλειτουργικότητας υγείας</skos:prefLabel>
    <skos:prefLabel xml:lang="sv">Snabba interoperabilitetsresurser för hälso- och sjukvård</skos:prefLabel>
    <skos:prefLabel xml:lang="et">Kiired tervishoiu koostalitlusvõime ressursid</skos:prefLabel>
    <skos:prefLabel xml:lang="bg">Ресурси за бърза оперативна съвместимост в здравеопазването</skos:prefLabel>
    <skos:prefLabel xml:lang="lt">Sparčiosios sveikatos priežiūros sąveikumo priemonės</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Szybkie zasoby interoperacyjności w opiece zdrowotnej</skos:prefLabel>
    <skos:prefLabel xml:lang="sl">Hitri viri interoperabilnosti v zdravstvu</skos:prefLabel>
    <skos:prefLabel xml:lang="fi">Nopeat terveydenhuollon yhteentoimivuusresurssit</skos:prefLabel>
    <skos:prefLabel xml:lang="ga">Acmhainní Idir-inoibritheachta Sciobtha Cúraim Sláinte</skos:prefLabel>
    <skos:prefLabel xml:lang="de">Schnelle Interoperabilitätsressourcen im Gesundheitswesen</skos:prefLabel>
    <skos:prefLabel xml:lang="it">Risorse rapide per l'interoperabilità sanitaria</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Ressources rapides d'interopérabilité en santé</skos:prefLabel>
    <skos:prefLabel xml:lang="ro">Resurse rapide de interoperabilitate în sănătate</skos:prefLabel>
    <skos:prefLabel xml:lang="cs">Rychlé prostředky interoperability ve zdravotnictví</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Rýchle prostriedky interoperability v zdravotníctve</skos:prefLabel>
    <skos:prefLabel xml:lang="da">Hurtige ressourcer til interoperabilitet i sundhedssektoren</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Snelle interoperabiliteitsbronnen voor de gezondheidszorg</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Recursos rápidos de interoperabilidade em saúde</skos:prefLabel>
    <skos:prefLabel xml:lang="hu">Gyors egészségügyi interoperabilitási erőforrások</skos:prefLabel>
    <skos:prefLabel xml:lang="lv">Ātrās veselības aprūpes savstarpējās izmantojamības resursi</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Fast Healthcare Interoperability Resources</skos:prefLabel>
    <rdf:type rdf:resource="http://purl.org/dc/terms/Standard"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://hdeu-dcat.data.health.europa.eu/resource/authority/standard/API"/>
    <dct:title xml:lang="en">Fast Healthcare Interoperability Resources</dct:title>
    <skos:definition xml:lang="en">HL7 standard for exchanging healthcare information electronically, based on modular resources and designed for implementation using modern web technologies. FHIR supports RESTful APIs and multiple exchange formats, including JSON, XML, and RDF.</skos:definition>
    <dct:identifier>FHIR</dct:identifier>
  </rdf:Description>
