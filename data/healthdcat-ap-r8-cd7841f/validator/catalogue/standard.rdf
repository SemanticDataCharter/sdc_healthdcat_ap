    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://hdeu-dcat.data.health.europa.eu/resource/authority/standard/DOCUMENT-FORMAT"/>
    <dct:title xml:lang="en">IHE Cross-Enterprise Document Sharing - IHE-XDS.b</dct:title>
    <skos:definition xml:lang="en">IHE integration profile for registering, distributing, discovering, and accessing patient electronic health-record documents across healthcare enterprises. It provides a standards-based way to manage document sharing between organizations such as physician offices, clinics, and hospitals.</skos:definition>
    <dct:identifier>IHE-XDS.b</dct:identifier>
  </rdf:Description>
