    <skos:prefLabel xml:lang="et">Kliiniliste dokumentide arhitektuur</skos:prefLabel>
    <rdf:type rdf:resource="http://purl.org/dc/terms/Standard"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:broader rdf:resource="https://hdeu-dcat.data.health.europa.eu/resource/authority/standard/DOCUMENT-FORMAT"/>
    <dct:title xml:lang="en">Clinical Document Architecture</dct:title>
    <skos:definition xml:lang="en">HL7 document markup standard that specifies the structure and semantics of clinical documents for exchange. CDA documents are XML-based, human-readable, and can include text, images, sounds, and other multimedia content.</skos:definition>
    <dct:identifier>CDA</dct:identifier>
  </rdf:Description>
