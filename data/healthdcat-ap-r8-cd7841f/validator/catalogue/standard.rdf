    <skos:broader rdf:resource="https://hdeu-dcat.data.health.europa.eu/resource/authority/standard/API"/>
    <dct:title xml:lang="en">HL7 Context Management Specification (CCOW)</dct:title>
    <skos:definition xml:lang="en">HL7 context-management standard for synchronising clinical applications at the point of use, so that separate systems can coordinate around shared context such as the current patient, user, or encounter. It supports visual/workflow integration across heterogeneous healthcare applications.</skos:definition>
    <dct:identifier>HL7-CCOW</dct:identifier>
  </rdf:Description>
