    <skos:prefLabel xml:lang="de">Health-Level-Seven-Standards</skos:prefLabel>
    <skos:prefLabel xml:lang="nl">Health Level Seven-standaarden</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Normas Health Level Seven</skos:prefLabel>
    <rdf:type rdf:resource="http://purl.org/dc/terms/Standard"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
