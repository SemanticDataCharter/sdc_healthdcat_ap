  <rdf:Description rdf:about="https://hdeu-dcat.data.health.europa.eu/resource/authority/standard/CDA">
    <skos:inScheme rdf:resource="https://hdeu-dcat.data.health.europa.eu/resource/authority/standard"/>
    <dct:description xml:lang="en">HL7 document markup standard that specifies the structure and semantics of clinical documents for exchange. CDA documents are XML-based, human-readable, and can include text, images, sounds, and other multimedia content.</dct:description>
    <skos:prefLabel xml:lang="fr">Architecture des documents cliniques</skos:prefLabel>
    <skos:prefLabel xml:lang="sk">Architektúra klinických dokumentov</skos:prefLabel>
