  <rdf:Description rdf:about="https://hdeu-dcat.data.health.europa.eu/resource/authority/standard/HL7-CCOW">
    <skos:inScheme rdf:resource="https://hdeu-dcat.data.health.europa.eu/resource/authority/standard"/>
    <dct:description xml:lang="en">HL7 context-management standard for synchronising clinical applications at the point of use, so that separate systems can coordinate around shared context such as the current patient, user, or encounter. It supports visual/workflow integration across heterogeneous healthcare applications.</dct:description>
