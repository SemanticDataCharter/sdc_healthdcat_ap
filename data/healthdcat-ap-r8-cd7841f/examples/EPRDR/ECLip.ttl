# --- Provenance ---
eclip:provenance
    a dct:ProvenanceStatement ;
    rdfs:label "Data collected from university hospitals and non-university hospitals. The ECLip Registry is a member of the European Reference Network on endocrine conditions (Endo-ERN). Registry uses OSSE software. Ethics approval: central Ethical review committee Ulm, local ethic approval at each centre in addition."@en .

# --- Dataset: ECLip ---
eclip:dataset
    a dcat:Dataset ;
    dct:title "[Test] ECLip-Registry"@en ;
    dct:description "The ECLip Registry enables physicians worldwide to work together in the field of lipodystrophy. It aims to accumulate sufficient data for sound research in this area. The Registry strives for a better understanding of the cause and course of lipodystrophy by comparing the natural course of the disease and current treatment strategies as well as their outcome."@en ;
    dct:identifier "ECLip" ;
    adms:identifier [
        a adms:Identifier ;
        skos:notation "7303" ;
        adms:schemaAgency "ERDRI.dor"
    ] ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    dct:type <http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL> ;
    healthdcatap:healthCategory <https://hdeu-dcat.data.health.europa.eu/resource/authority/healthcategories/MRMR> ;
    dct:spatial <http://publications.europa.eu/resource/authority/country/DEU> ;
    dcat:keyword "Lipodystrophy"@en, "Epidemiology"@en, "Clinical"@en, "Basic research"@en, "Pharmacological research"@en, "Patient driven"@en, "Rare disease"@en, "Endo-ERN"@en ;
    healthdcatap:numberOfRecords "800"^^xsd:nonNegativeInteger ;
    healthdcatap:numberOfUniqueIndividuals "800"^^xsd:nonNegativeInteger ;
    healthdcatap:populationCoverage "All patients with lipodystrophy not related to HIV can be included"@en ;
    healthdcatap:hasStructuredData "true"^^xsd:boolean ;
    healthdcatap:hasVariables eclip:variables ;
    healthdcatap:retentionPeriod [
        a dct:PeriodOfTime ;
        dcat:startDate "2023-05-02"^^xsd:date ;
        dcat:endDate "2038-12-31"^^xsd:date
    ] ;
    dct:provenance eclip:provenance ;
    healthdcatap:hasCodeValues "ORPHA:3455", "ORPHA:79085", "ORPHA:90159", "ORPHA:324999", "ORPHA:528", "ORPHA:50811", "ORPHA:363400", "ORPHA:902", "ORPHA:79086", "ORPHA:90153", "ORPHA:300382", "ORPHA:2348", "ORPHA:67036", "ORPHA:1214", "ORPHA:79083", "ORPHA:435660", "ORPHA:280356", "ORPHA:79084", "ORPHA:90156", "ORPHA:98307", "ORPHA:90154", "ORPHA:2615", "ORPHA:90158", "ORPHA:325004", "ORPHA:435628", "ORPHA:435651", "ORPHA:435953", "ORPHA:79087", "ORPHA:740", "ORPHA:500062", "ORPHA:79474", "ORPHA:91", "ORPHA:90157", "ORPHA:3163", "ORPHA:280576", "ORPHA:363649" ;
    healthdcatap:hasCodingSystem <https://hdeu-dcat.data.health.europa.eu/resource/authority/coding-system/ORPHACODE> ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    foaf:page <https://eu-rd-platform.jrc.ec.europa.eu/erdridor/register/7303> ;
    dcat:contactPoint eclip:dataset-contact-point ;
    geodcatap:custodian eclip:custodian-agent ;
    healthdcatap:hdab eclip:hdab-agent ;
    healthdcatap:hdabCoordinator eclip:hdab-coordinator-agent ;
    dct:publisher eclip:publisher-agent ;
    dpv:hasPersonalData dpvpd:Gender, dpvpd:Age, dpvpd:HealthRecord, dpvpd:MedicalHealth, dpvpd:Genetic ;
    dpv:hasPurpose [
        a dpv:Purpose ;
        dct:description "Clinical and epidemiological research on lipodystrophy: collecting demographic, clinical, genetic, and therapeutic data to improve understanding of disease mechanisms, natural history, and treatment outcomes."@en
    ] ;
    dpv:hasLegalBasis [
        a dpv:LegalBasis ;
        dct:description "Processing based on the EHDS Regulation (EU) 2025/327 for secondary use of health data. Ethics approval: central Ethical review committee Ulm, local ethic approval at each centre in addition."@en
    ] ;
    healthdcatap:healthTheme <https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/NONCOMMUNICABLE_DISEASES> ;
    healthdcatap:minTypicalAge "0"^^xsd:nonNegativeInteger ;
    healthdcatap:maxTypicalAge "80"^^xsd:nonNegativeInteger ;
    dqv:hasQualityAnnotation [
        a dqv:QualityCertificate ;
        oa:motivatedBy dqv:qualityAssessment ;
        oa:hasBody <https://eu-rd-platform.jrc.ec.europa.eu/erdridor/register/7303>
    ] ;
    adms:sample eclip:sample-distribution ;
    healthdcatap:analytics eclip:analytics-distribution ;
    dcat:distribution eclip:distribution-erdri .

