# --- Provenance ---
aidabd:provenance
    a dct:ProvenanceStatement ;
    rdfs:label "Data collected from university hospitals, non-university hospitals, and research institutions worldwide. The AIDA Network Behcet disease registry is a member of the European Reference Network on immunodeficiency, autoinflammatory and autoimmune diseases (ERN RITA). Registry uses REDCap software. Ethics approval: Ethics Committee of Azienda Ospedaliera Universitaria Senese, Siena, Italy (Ref. N. 14951). Collaboration available."@en .

# --- Dataset: AIDA BD ---
aidabd:dataset
    a dcat:Dataset ;
    dct:title "[Test] AIDA Network Behcet disease registry"@en ;
    dct:description "The registry collects demographic, clinical, genetic, and therapeutic data of patients affected by Behcet's disease."@en ;
    dct:identifier "AIDA-BD" ;
    adms:identifier [
        a adms:Identifier ;
        skos:notation "6317" ;
        adms:schemaAgency "ERDRI.dor"
    ] ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    dct:type <http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL> ;
    healthdcatap:healthCategory <https://hdeu-dcat.data.health.europa.eu/resource/authority/healthcategories/MRMR> ;
    dct:spatial <http://publications.europa.eu/resource/authority/country/ITA> ;
    dcat:keyword "Autoinflammatory diseases"@en, "Clinical"@en, "Rare disease"@en, "ERN RITA"@en, "Behcet disease"@en ;
    healthdcatap:numberOfRecords "1455"^^xsd:nonNegativeInteger ;
    healthdcatap:numberOfUniqueIndividuals "1455"^^xsd:nonNegativeInteger ;
    healthdcatap:populationCoverage "Subjects of any age classified as affected by Behcet's disease according to the ISG, ICBD or PEDBD criteria can be enrolled."@en ;
    healthdcatap:hasStructuredData "true"^^xsd:boolean ;
    healthdcatap:hasVariables aidabd:variables ;
    healthdcatap:retentionPeriod [
        a dct:PeriodOfTime ;
        dcat:startDate "2021-01-31"^^xsd:date ;
        dcat:endDate "2036-12-31"^^xsd:date
    ] ;
    dct:provenance aidabd:provenance ;
    healthdcatap:hasCodeValues "ORPHA:117" ;
    healthdcatap:hasCodingSystem <https://hdeu-dcat.data.health.europa.eu/resource/authority/coding-system/ORPHACODE> ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    foaf:page <https://eu-rd-platform.jrc.ec.europa.eu/erdridor/register/6317>, <https://aidanetwork.org/en/> ;
    dcat:contactPoint aidabd:dataset-contact-point ;
    geodcatap:custodian aidabd:custodian-agent ;
    healthdcatap:hdab aidabd:hdab-agent ;
    healthdcatap:hdabCoordinator aidabd:hdab-coordinator-agent ;
    dct:publisher aidabd:publisher-agent ;
    dpv:hasPersonalData dpvpd:Gender, dpvpd:Age, dpvpd:HealthRecord, dpvpd:MedicalHealth, dpvpd:Genetic ;
    dpv:hasPurpose [
        a dpv:Purpose ;
        dct:description "Clinical research on Behcet's disease: collecting demographic, clinical, genetic, and therapeutic data to improve understanding of disease mechanisms, treatment outcomes, and patient care."@en
    ] ;
    dpv:hasLegalBasis [
        a dpv:LegalBasis ;
        dct:description "Processing based on the EHDS Regulation (EU) 2025/327 for secondary use of health data, and Ethics Committee approval of Azienda Ospedaliera Universitaria Senese, Siena, Italy (Ref. N. 14951)."@en
    ] ;
    healthdcatap:healthTheme <https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/NONCOMMUNICABLE_DISEASES> ;
    healthdcatap:minTypicalAge "0"^^xsd:nonNegativeInteger ;
    healthdcatap:maxTypicalAge "90"^^xsd:nonNegativeInteger ;
    dqv:hasQualityAnnotation [
        a dqv:QualityCertificate ;
        oa:motivatedBy dqv:qualityAssessment ;
        oa:hasBody <https://eu-rd-platform.jrc.ec.europa.eu/erdridor/register/6317>
    ] ;
    adms:sample aidabd:sample-distribution ;
    healthdcatap:analytics aidabd:analytics-distribution ;
    dcat:distribution aidabd:distribution-erdri .

