    cv:contactPoint agora:hdab-coordinator-contact-point .

agora:hdab-coordinator-contact-point
    a cv:ContactPoint ;
    cv:contactPage <https://european-union.europa.eu/> .

# --- Custodian (Data Holder) ---
agora:custodian-agent
    a foaf:Agent ;
    foaf:name "Radboudumc - AGORA data- and biobank"@en ;
    dct:type <https://hdeu-dcat.data.health.europa.eu/resource/authority/publisher-type/non-gov-org> ;
    cv:contactPoint agora:custodian-contact-point .

agora:custodian-contact-point
    a cv:ContactPoint ;
    cv:contactPage <https://www.radboudumc.nl/en/> .

# --- Dataset: AGORA ---
<https://eu-rd-platform.jrc.ec.europa.eu/mdr/detail/AGORA>
    a dcat:Dataset ;
    dct:title "[Test] AGORA"@en ;
    dct:description "The causes of most congenital malformations are largely unknown. Both genetic predisposition and circumstances shortly before and during pregnancy may play a role. AGORA (Aetiologic research into Genetic and Occupational / Environmental Risk factors for Anomalies in children) aims to facilitate research into the causes and consequences of congenital malformations. Blood is drawn from patients and their parents. Parents are asked to complete a questionnaire about circumstances around pregnancy. This registry contains 89 variables."@en ;
    dct:identifier "AGORA" ;
    adms:identifier [
        a adms:Identifier ;
        skos:notation "6351" ;
        adms:schemaAgency "ERDRI.dor"
    ] ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
    dct:type <http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL> ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:publisher agora:publisher-jrc ;
    geodcatap:custodian agora:custodian-agent ;
    healthdcatap:hdab agora:hdab-agent ;
    healthdcatap:hdabCoordinator agora:hdab-coordinator-agent ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    dcat:keyword "rare disease"@en, "congenital malformations"@en, "patient registry"@en, "AGORA"@en, "biobank"@en, "congenital defects"@en, "childhood cancer"@en, "embryogenesis"@en ;
    healthdcatap:hasCodeValues "ORPHA:93890", "ORPHA:519", "ORPHA:668", "ORPHA:635", "ORPHA:182067", "ORPHA:251636", "ORPHA:513", "ORPHA:616", "ORPHA:547", "ORPHA:449", "ORPHA:94", "ORPHA:370348", "ORPHA:98293", "ORPHA:54595", "ORPHA:780", "ORPHA:654", "ORPHA:3399" ;
    healthdcatap:hasCodingSystem <https://hdeu-dcat.data.health.europa.eu/resource/authority/coding-system/ORPHACODE> ;
    healthdcatap:healthCategory <https://hdeu-dcat.data.health.europa.eu/resource/authority/healthcategories/MRMR> ;
    healthdcatap:healthTheme <https://hdeu-dcat.data.health.europa.eu/resource/authority/health-theme/NONCOMMUNICABLE_DISEASES> ;
    dcat:contactPoint agora:dataset-contact-point ;
    dcat:landingPage <https://european-union.europa.eu/> ;
    foaf:page <https://eu-rd-platform.jrc.ec.europa.eu/erdridor/register/6351> ,
        <https://www.agoraproject.nl/> ;
    dct:spatial <http://publications.europa.eu/resource/authority/country/NLD> ;
    dct:provenance agora:provenance ;
    healthdcatap:hasStructuredData true ;
    healthdcatap:hasVariables agora:variables-group ;
    healthdcatap:populationCoverage "Children with congenital malformations and their parents, treated at Radboudumc in the Netherlands."@en ;
    dcat:distribution agora:distribution-hdab ;
    dpv:hasPurpose agora:purpose ;
    dpv:hasLegalBasis [
        a dpv:LegalBasis ;
        dct:description "Processing is based on the EHDS Regulation (EU) 2025/327 for secondary use of health data, and applicable national legislation in the Netherlands governing biobank and registry research."@en
    ] ;
    dpv:hasPersonalData <https://w3id.org/dpv/dpv-pd#Gender>, <https://w3id.org/dpv/dpv-pd#Age>, <https://w3id.org/dpv/dpv-pd#HealthRecord> ;
    healthdcatap:minTypicalAge "0"^^xsd:nonNegativeInteger ;
    healthdcatap:maxTypicalAge "18"^^xsd:nonNegativeInteger ;
    healthdcatap:numberOfRecords "3500"^^xsd:nonNegativeInteger ;
    healthdcatap:numberOfUniqueIndividuals "3500"^^xsd:nonNegativeInteger ;
    healthdcatap:retentionPeriod [
        a dct:PeriodOfTime ;
        dcat:startDate "2003-01-01"^^xsd:date ;
        dcat:endDate "2030-12-31"^^xsd:date
    ] ;
    adms:sample agora:sample-distribution ;
    healthdcatap:analytics agora:analytics-distribution ;
    dqv:hasQualityAnnotation [
        a dqv:QualityCertificate ;
        oa:motivatedBy dqv:qualityAssessment ;
        oa:hasBody <https://eu-rd-platform.jrc.ec.europa.eu/mdr/detail/AGORA>
    ] ;
    prov:wasGeneratedBy agora:generation-activity .

# --- Dataset Contact Point ---
agora:dataset-contact-point
    a vcard:Kind ;
    vcard:hasURL <https://european-union.europa.eu/> ;
    vcard:hasEmail <mailto:union_body@europa.eu> .

# --- Provenance ---
agora:provenance
    a dct:ProvenanceStatement ;
    rdfs:label "The causes of most congenital malformations are largely unknown. Both genetic predisposition and circumstances shortly before and during pregnancy may play a role. Data is collected from patients with congenital malformations and their parents at Radboudumc. Blood samples are drawn and parents complete questionnaires about circumstances around pregnancy. Data providers include university hospitals, non-university hospitals, patients, families and research institutions."@en .

# --- Purpose ---
agora:purpose
    a dpv:Purpose ;
    dct:description "Secondary-use research into the aetiologic, genetic and occupational/environmental risk factors for congenital anomalies in children, including identification of causes and long-term consequences of malformations."@en .

# --- Generation Activity ---
agora:generation-activity
    a prov:Activity ;
    rdfs:label "Patient registry data collection through clinical encounters and questionnaires"@en ;
    dct:type <https://hdeu-dcat.data.health.europa.eu/resource/authority/health-activity/ROUTINE_RECORDS> .

# --- Distribution (HDAB access) ---
agora:distribution-hdab
    a dcat:Distribution ;
    dct:title "AGORA Registry Data Access via HDAB"@en ;
    dct:description "Access to the AGORA registry data is provided through the EU RD Platform Health Data Access Body. Access is conditional on approval of a data request application."@en ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
    dcat:accessURL <https://eu-rd-platform.jrc.ec.europa.eu/erdridor/register/6351> ;
    dct:format <http://publications.europa.eu/resource/authority/file-type/HTML> ;
    dcatap:availability <http://publications.europa.eu/resource/authority/planned-availability/AVAILABLE> ;
    dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0> ;
    dct:rights [
        a dct:RightsStatement ;
        rdfs:label "Access to data is conditional on the issuance of a permit by the HDAB after submission of a data request application."@en
    ] .

# --- Sample Distribution ---
agora:sample-distribution
    a dcat:Distribution ;
    dct:title "AGORA Registry Sample Data"@en ;
    dct:description "Synthetic sample data representing the structure of the AGORA registry variables."@en ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
    dcat:accessURL <https://eu-rd-platform.jrc.ec.europa.eu/erdridor/register/6351> ;
    dct:format <http://publications.europa.eu/resource/authority/file-type/CSV> ;
    dcatap:availability <http://publications.europa.eu/resource/authority/planned-availability/AVAILABLE> ;
    dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0> ;
    adms:status <http://publications.europa.eu/resource/authority/distribution-status/COMPLETED> .

# --- Analytics Distribution ---
agora:analytics-distribution
    a dcat:Distribution ;
    dct:title "AGORA Registry Analytics Report"@en ;
    dct:description "Summary statistics and data quality report for the AGORA registry."@en ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg/2025/327/oj> ;
    dcat:accessURL <https://eu-rd-platform.jrc.ec.europa.eu/erdridor/register/6351> ;
    dct:format <http://publications.europa.eu/resource/authority/file-type/HTML> ;
    dcatap:availability <http://publications.europa.eu/resource/authority/planned-availability/AVAILABLE> ;
    dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0> .

# =============================================================================
# AGORA VARIABLES (89 variables) - CSVW model per HealthDCAT-AP Section 7.14
# Source: https://eu-rd-platform.jrc.ec.europa.eu/mdr/detail/AGORA
# =============================================================================

# --- CSVW TableGroup ---
agora:variables-group
    a csvw:TableGroup ;
    dct:title "AGORA data- and biobank"@en ;
    csvw:table agora:table-demographics ,
        agora:table-digestive ,
        agora:table-abdominal-respiratory ,
        agora:table-genitourinary ,
        agora:table-renal ,
        agora:table-schisis ,
        agora:table-cardiac ,
        agora:table-skeletal ,
        agora:table-cns ,
        agora:table-gynaecological ,
        agora:table-other-diagnosis ,
        agora:table-other-details ,
        agora:table-sample .

# --- Table 1: Demographics (5 variables) ---
agora:table-demographics
    a csvw:Table ;
    dct:title "Demographics"@en ;
    dcat:keyword "demographics"@en, "patient identification"@en ;
    csvw:column agora:col-monthofbirth, agora:col-yearofbirth, agora:col-gender,
        agora:col-informedconsent, agora:col-iservragenlijst .

agora:col-monthofbirth a csvw:Column ;
    csvw:name "monthofbirth" ;
    csvw:title "Month of birth"@en ;
    csvw:datatype "integer" ;
    dct:description "Patient's month of birth."@en .

agora:col-yearofbirth a csvw:Column ;
    csvw:name "yearofbirth" ;
    csvw:title "Year of birth"@en ;
    csvw:datatype "integer" ;
    dct:description "Patient's year of birth."@en .

agora:col-gender a csvw:Column ;
    csvw:name "gender" ;
    csvw:title "Gender"@en ;
    csvw:datatype "string" ;
    dct:description "Patient's sex at birth."@en .

agora:col-informedconsent a csvw:Column ;
    csvw:name "informedconsent" ;
    csvw:title "Informed consent"@en ;
    csvw:datatype "string" ;
    dct:description "Is informed consent present?"@en .

agora:col-iservragenlijst a csvw:Column ;
    csvw:name "iservragenlijst" ;
    csvw:title "Is a questionnaire present?"@en ;
    csvw:datatype "string" ;
    dct:description "Is a questionnaire present?"@en .

# --- Table 2: Digestive organ malformations (7 variables) ---
agora:table-digestive
    a csvw:Table ;
    dct:title "Malformations digestive organs"@en ;
    dcat:keyword "digestive"@en, "anorectal"@en, "malformation"@en ;
    csvw:column agora:col-afwspijs, agora:col-detailanorectmalf,
        agora:col-detailanorectmalfspec, agora:col-tracheoesofagfistel,
        agora:col-galgangatresie, agora:col-afwspijsanders, agora:col-afwspijsandersspec .

agora:col-afwspijs a csvw:Column ;
    csvw:name "afwspijs" ;
    csvw:title "Are there digestive organ abnormalities?"@en ;
    csvw:datatype "string" ;
    dct:description "Indicates presence of digestive organ abnormalities."@en .

agora:col-detailanorectmalf a csvw:Column ;
    csvw:name "detailanorectmalf" ;
    csvw:title "Detail anorectal malformation"@en ;
    csvw:datatype "string" ;
    dct:description "Detail of anorectal malformation type."@en .

agora:col-detailanorectmalfspec a csvw:Column ;
    csvw:name "detailanorectmalfspec" ;
    csvw:title "Specification details anorectal malformation"@en ;
    csvw:datatype "string" ;
    dct:description "Specification details of anorectal malformation."@en .

agora:col-tracheoesofagfistel a csvw:Column ;
    csvw:name "tracheoesofagfistel" ;
    csvw:title "Tracheoesophageal fistula"@en ;
    csvw:datatype "string" ;
    dct:description "Presence of tracheoesophageal fistula."@en .

agora:col-galgangatresie a csvw:Column ;
    csvw:name "galgangatresie" ;
    csvw:title "Bile duct atresia"@en ;
    csvw:datatype "string" ;
    dct:description "Presence of bile duct atresia."@en .

agora:col-afwspijsanders a csvw:Column ;
    csvw:name "afwspijsanders" ;
    csvw:title "Other digestive organ abnormalities"@en ;
    csvw:datatype "string" ;
    dct:description "Other digestive organ abnormalities not listed above."@en .

agora:col-afwspijsandersspec a csvw:Column ;
    csvw:name "afwspijsandersspec" ;
    csvw:title "Specification other digestive organ abnormalities"@en ;
    csvw:datatype "string" ;
    dct:description "Free text specification of other digestive organ abnormalities."@en .

# --- Table 3: Abdominal and respiratory tract (3 variables) ---
agora:table-abdominal-respiratory
    a csvw:Table ;
    dct:title "Abnormalities abdominal and respiratory tract"@en ;
    dcat:keyword "abdominal"@en, "respiratory"@en ;
    csvw:column agora:col-afwbuik, agora:col-afwbuikanders, agora:col-afwbuikandersspec .

agora:col-afwbuik a csvw:Column ;
    csvw:name "afwbuik" ;
    csvw:title "Are there abdominal and respiratory tract abnormalities?"@en ;
    csvw:datatype "string" ;
    dct:description "Indicates presence of abdominal and respiratory tract abnormalities."@en .

agora:col-afwbuikanders a csvw:Column ;
    csvw:name "afwbuikanders" ;
    csvw:title "Other abdominal and respiratory tract abnormalities"@en ;
    csvw:datatype "string" ;
    dct:description "Other abdominal and respiratory tract abnormalities."@en .

agora:col-afwbuikandersspec a csvw:Column ;
    csvw:name "afwbuikandersspec" ;
    csvw:title "Specification other abdominal and respiratory tract abnormalities"@en ;
    csvw:datatype "string" ;
    dct:description "Free text specification of other abdominal and respiratory tract abnormalities."@en .

# --- Table 4: Genitourinary system (10 variables) ---
agora:table-genitourinary
    a csvw:Table ;
    dct:title "Genitourinary system"@en ;
    dcat:keyword "genitourinary"@en, "urogenital"@en ;
    csvw:column agora:col-afwurogen, agora:col-hypospadie,
        agora:col-vesicoureteralerefluxspec, agora:col-graadvur,
        agora:col-uterusafwijkingen, agora:col-utriculuscyste,
        agora:col-variocele, agora:col-incontinentie,
        agora:col-afwurogenanders, agora:col-afwurogenandersspec .

agora:col-afwurogen a csvw:Column ;
    csvw:name "afwurogen" ;
    csvw:title "Are there genitourinary system abnormalities?"@en ;
    csvw:datatype "string" ;
    dct:description "Indicates presence of genitourinary system abnormalities."@en .

agora:col-hypospadie a csvw:Column ;
    csvw:name "hypospadie" ;
    csvw:title "Hypospadias"@en ;
    csvw:datatype "string" ;
    dct:description "Presence of hypospadias."@en .

agora:col-vesicoureteralerefluxspec a csvw:Column ;
    csvw:name "vesicoureteralerefluxspec" ;
    csvw:title "Vesicoureteral reflux (VUR)"@en ;
    csvw:datatype "string" ;
    dct:description "Presence of vesicoureteral reflux."@en .

agora:col-graadvur a csvw:Column ;
    csvw:name "graadvur" ;
    csvw:title "Grade VUR"@en ;
    csvw:datatype "string" ;
    dct:description "Grade of vesicoureteral reflux."@en .

agora:col-uterusafwijkingen a csvw:Column ;
    csvw:name "uterusafwijkingen" ;
    csvw:title "Uterine abnormality"@en ;
    csvw:datatype "string" ;
    dct:description "Presence of uterine abnormality."@en .

agora:col-utriculuscyste a csvw:Column ;
    csvw:name "utriculuscyste" ;
    csvw:title "Utricle cyst"@en ;
    csvw:datatype "string" ;
    dct:description "Presence of utricle cyst."@en .

agora:col-variocele a csvw:Column ;
    csvw:name "variocele" ;
    csvw:title "Varicocele"@en ;
    csvw:datatype "string" ;
    dct:description "Presence of varicocele."@en .

agora:col-incontinentie a csvw:Column ;
    csvw:name "incontinentie" ;
    csvw:title "Incontinence"@en ;
    csvw:datatype "string" ;
    dct:description "Presence of incontinence."@en .

agora:col-afwurogenanders a csvw:Column ;
    csvw:name "afwurogenanders" ;
    csvw:title "Other genitourinary system abnormalities"@en ;
    csvw:datatype "string" ;
    dct:description "Other genitourinary system abnormalities."@en .

agora:col-afwurogenandersspec a csvw:Column ;
    csvw:name "afwurogenandersspec" ;
    csvw:title "Specification other genitourinary system abnormalities"@en ;
    csvw:datatype "string" ;
    dct:description "Free text specification of other genitourinary system abnormalities."@en .

# --- Table 5: Renal abnormalities (9 variables) ---
agora:table-renal
    a csvw:Table ;
    dct:title "Renal abnormalities"@en ;
    dcat:keyword "renal"@en, "kidney"@en ;
    csvw:column agora:col-afwnier, agora:col-nierplaats, agora:col-upjstenose,
        agora:col-momdiaghydronef, agora:col-dubbelsysteem,
        agora:col-nierinsufficientie, agora:col-afunctionelenier,
        agora:col-afwnierenanders, agora:col-afwnierenandersspec .

agora:col-afwnier a csvw:Column ;
    csvw:name "afwnier" ;
    csvw:title "Are there renal abnormalities?"@en ;
    csvw:datatype "string" ;
    dct:description "Indicates presence of renal abnormalities."@en .

agora:col-nierplaats a csvw:Column ;
    csvw:name "nierplaats" ;
    csvw:title "Location renal/urogenic abnormality"@en ;
    csvw:datatype "string" ;
    dct:description "Location of renal or urogenic abnormality."@en .

agora:col-upjstenose a csvw:Column ;
    csvw:name "upjstenose" ;
    csvw:title "UPJ stenosis"@en ;
    csvw:datatype "string" ;
    dct:description "Presence of UPJ stenosis."@en .

agora:col-momdiaghydronef a csvw:Column ;
    csvw:name "momdiaghydronef" ;
    csvw:title "Moment of hydronephrosis diagnosis"@en ;
    csvw:datatype "string" ;
    dct:description "Moment of hydronephrosis diagnosis."@en .

agora:col-dubbelsysteem a csvw:Column ;
    csvw:name "dubbelsysteem" ;
    csvw:title "Duplicated collecting system"@en ;
    csvw:datatype "string" ;
    dct:description "Presence of duplicated collecting system."@en .

agora:col-nierinsufficientie a csvw:Column ;
    csvw:name "nierinsufficientie" ;
    csvw:title "Renal insufficiency"@en ;
    csvw:datatype "string" ;
    dct:description "Presence of renal insufficiency."@en .

agora:col-afunctionelenier a csvw:Column ;
    csvw:name "afunctionelenier" ;
    csvw:title "Afunctional kidney"@en ;
    csvw:datatype "string" ;
    dct:description "Presence of afunctional kidney."@en .

agora:col-afwnierenanders a csvw:Column ;
    csvw:name "afwnierenanders" ;
    csvw:title "Other renal abnormalities"@en ;
    csvw:datatype "string" ;
    dct:description "Other renal abnormalities."@en .

agora:col-afwnierenandersspec a csvw:Column ;
    csvw:name "afwnierenandersspec" ;
    csvw:title "Specification other renal abnormalities"@en ;
    csvw:datatype "string" ;
    dct:description "Free text specification of other renal abnormalities."@en .

# --- Table 6: Schisis (5 variables) ---
agora:table-schisis
    a csvw:Table ;
    dct:title "Schisis"@en ;
    dcat:keyword "schisis"@en, "cleft"@en ;
    csvw:column agora:col-afwschisis, agora:col-cheiloschisis,
        agora:col-pierrerobinsequentie, agora:col-afwschisisanders,
        agora:col-afwschisisandersspec .

agora:col-afwschisis a csvw:Column ;
    csvw:name "afwschisis" ;
    csvw:title "Are there schismatic abnormalities?"@en ;
    csvw:datatype "string" ;
    dct:description "Indicates presence of schismatic abnormalities."@en .

agora:col-cheiloschisis a csvw:Column ;
    csvw:name "cheiloschisis" ;
    csvw:title "Cheiloschisis"@en ;
    csvw:datatype "string" ;
    dct:description "Presence of cheiloschisis (cleft lip)."@en .

agora:col-pierrerobinsequentie a csvw:Column ;
    csvw:name "pierrerobinsequentie" ;
    csvw:title "Pierre Robin Sequence"@en ;
    csvw:datatype "string" ;
    dct:description "Presence of Pierre Robin Sequence."@en .

agora:col-afwschisisanders a csvw:Column ;
