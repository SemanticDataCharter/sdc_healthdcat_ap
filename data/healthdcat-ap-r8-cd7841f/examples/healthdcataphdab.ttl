@prefix healthdcatap: <http://healthdataportal.eu/ns/health#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix cv:        <http://data.europa.eu/m8g/> .
@prefix ex:        <http://example.com/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix time: <http://www.w3.org/2006/time#> .

<https://fair.healthdata.be/dataset/d43a158e-7d13-4660-bbc3-9d3f8d5501e5>
	healthdcatap:hdab
		[
			a foaf:Agent;
			foaf:name "Health Data Access Body France";
			dct:type <https://hdeu-dcat.data.health.europa.eu/resource/authority/publisher-type/non-gov-org> ;
			cv:contactPoint ex:cp
		] .
		
ex:cp a cv:ContactPoint ;

  cv:email "hdab-contact@example.com" ;
  cv:contactPage <https://www.kadaster.nl/contact> ;
  cv:telephone "+32 257 25757" ;			
  cv:openingHours ex:oh ;
  cv:specialOpeningHoursSpecification ex:sohs .

<https://www.kadaster.nl/contact> a foaf:Document .
<http://publications.europa.eu/resource/authority/frequency/DAILY> a dct:Frequency .
<http://publications.europa.eu/resource/authority/frequency/WEEKLY> a dct:Frequency .

ex:oh a time:TemporalEntity ;
  dct:description "Every working day from 9 a.m. to 5 p.m."@en ;
  cv:frequency <http://publications.europa.eu/resource/authority/frequency/DAILY> .

ex:sohs a time:TemporalEntity ;
  dct:description "Closed on weekend"@en ;
  cv:frequency <http://publications.europa.eu/resource/authority/frequency/WEEKLY> .			