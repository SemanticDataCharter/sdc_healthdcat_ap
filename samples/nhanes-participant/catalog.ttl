    healthdcatap:maxTypicalAge "80"^^xsd:nonNegativeInteger ;
    healthdcatap:minTypicalAge "0"^^xsd:nonNegativeInteger ;
    healthdcatap:numberOfRecords "9254"^^xsd:nonNegativeInteger ;
    healthdcatap:numberOfUniqueIndividuals "9254"^^xsd:nonNegativeInteger ;
    healthdcatap:populationCoverage "Participants of the National Health and Nutrition Examination Survey 2017-2018 (CDC), civilian noninstitutionalized population of the United States, all ages."@en ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC> ;
    dct:creator [ a foaf:Agent ;
            foaf:name "Timothy Cook" ] ;
    dct:description "SDC4 data model for National Health and Nutrition Examination Survey (nhanes_blood_pressure) — FAIR Data Demo. Each record is a governed data record conforming to the Semantic Data Charter model NHANES Participant (dm-xy8upneajsb8vdcmnve01g6g), published 2026-09-26. The schema is immutable and defines every variable's name, definition, datatype, units and permitted values; it is cited by URL and SHA-256 as the standard the records conform to and as the page that documents them."@en ;
    dct:identifier "dm-xy8upneajsb8vdcmnve01g6g" ;
    dct:issued "2026-09-26"^^xsd:date ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
    dct:license <http://creativecommons.org/licenses/by/3.0/> ;
    dct:modified "2026-09-26"^^xsd:date ;
    dct:provenance [ a dct:ProvenanceStatement ;
            rdfs:label "A published Semantic Data Charter model never changes; a revision is a new model naming the one it revised (prov:wasRevisionOf). See https://semanticdatacharter.com/permanence.html."@en ] ;
    dct:publisher <https://axius-sdc.com> ;
    dct:title "NHANES Participant governed data records"@en ;
    dct:type <http://publications.europa.eu/resource/authority/dataset-type/STATISTICAL> ;
    adms:identifier [ a adms:Identifier ;
            skos:notation "dm-xy8upneajsb8vdcmnve01g6g" ;
            adms:schemaAgency "Semantic Data Charter" ] ;
    dcat:contactPoint [ a vcard:Kind ;
            vcard:fn "Axius SDC, Inc. HealthDCAT-AP contact" ;
            vcard:hasEmail <mailto:contact@axius-sdc.com> ] ;
    dcat:distribution <https://semanticdatacharter.com/ns/sdc4/dm-xy8upneajsb8vdcmnve01g6g#distribution> ;
    dcat:keyword "FAIR Data Demo"@en,
        "SDC4"@en,
        "Semantic Data Charter"@en,
        "governed data record"@en ;
    dcat:landingPage <https://sdcstudio.axius-sdc.com/api/v1/catalog/dm/xy8upneajsb8vdcmnve01g6g/> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    dcat:version "0df45878b0db1c1515e860a4b9993c5f086ffaaebc4c16aaae2092e1da3d3b3b" ;
    dqv:hasQualityAnnotation [ a dqv:QualityCertificate ;
            oa:hasBody <https://sdcstudio.axius-sdc.com/dmlib/dm-xy8upneajsb8vdcmnve01g6g.xsd?sha256=0df45878b0db1c1515e860a4b9993c5f086ffaaebc4c16aaae2092e1da3d3b3b> ;
            oa:motivatedBy dqv:qualityAssessment ] ;
    foaf:page <https://sdcstudio.axius-sdc.com/dmlib/dm-xy8upneajsb8vdcmnve01g6g.xsd> ;
    dpv:hasLegalBasis [ a dpv:LegalBasis ;
            dct:description "Public-use survey data released by the CDC National Center for Health Statistics, re-expressed as governed data records by the FAIR Data Demo; secondary use under the terms of the source release."@en ] ;
    dpv:hasPersonalData <https://w3id.org/dpv/dpv-pd#Age>,
        <https://w3id.org/dpv/dpv-pd#Gender>,
        <https://w3id.org/dpv/dpv-pd#HealthRecord> ;
    dpv:hasPurpose [ a dpv:Purpose ;
            dct:description "Demonstration of governed data records for secondary-use research on population health, blood pressure, laboratory results and health behaviour."@en ] .

