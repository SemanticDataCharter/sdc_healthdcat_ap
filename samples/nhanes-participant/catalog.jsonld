  "http://purl.org/dc/terms/description": [
   {
    "@language": "en",
    "@value": "SDC4 data model for National Health and Nutrition Examination Survey (nhanes_blood_pressure) — FAIR Data Demo. Each record is a governed data record conforming to the Semantic Data Charter model NHANES Participant (dm-xy8upneajsb8vdcmnve01g6g), published 2026-09-26. The schema is immutable and defines every variable's name, definition, datatype, units and permitted values; it is cited by URL and SHA-256 as the standard the records conform to and as the page that documents them."
   }
  ],
